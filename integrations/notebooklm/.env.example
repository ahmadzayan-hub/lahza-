# ---- NotebookLM Enterprise — Google OAuth2 (authorization-code flow) ----
# Copy the values you need into your app's .env.local. NEVER commit real secrets.
#
# Prerequisites (see ./README.md):
#   1. A Google Cloud project with the Discovery Engine API enabled and
#      NotebookLM Enterprise provisioned.
#   2. An OAuth 2.0 "Web application" client (APIs & Services -> Credentials).
#   3. The redirect URI below added to that client's authorized redirect URIs.

# OAuth 2.0 Web client credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match an authorized redirect URI on the OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/notebooklm/callback

# NotebookLM Enterprise target (project NUMBER, not project id)
NOTEBOOKLM_PROJECT_NUMBER=
# Resource location for notebooks: global | us | eu
NOTEBOOKLM_LOCATION=global
# Discovery Engine endpoint host prefix: global | us | eu
NOTEBOOKLM_ENDPOINT_LOCATION=global

# Optional. Space- or comma-separated. Defaults to the cloud-platform scope.
NOTEBOOKLM_SCOPES=https://www.googleapis.com/auth/cloud-platform
