# Database (MySQL) — used by Drizzle ORM and the Hono server
DATABASE_URL="mysql://root:root@localhost:3306/beyond_style"

# Server
PORT=8787

# Cloudinary image CDN (delivery only; transformations f_auto,q_auto applied client-side)
VITE_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# Free shipping threshold in AED
VITE_FREE_SHIPPING_THRESHOLD=200

# Analytics (exposed to client)
VITE_GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
VITE_META_PIXEL_ID="0000000000000000"

# COD verification — WhatsApp Cloud API (server-side secrets, never exposed to client)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TEMPLATE="cod_order_verification"
# Comma-free E.164 ops number that receives COD verification pings
OPS_WHATSAPP_TO="+9715XXXXXXXX"

# Stripe card payments (server-side). Webhook confirms checkout.session.completed.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Base URL used for Stripe success/cancel redirects when no Origin header is present
PUBLIC_BASE_URL="http://localhost:5173"

# Admin auth (sent as the x-admin-token header by /admin).
# Single operator:
ADMIN_TOKEN=""
# Or a team — comma-separated name:token pairs (actor names appear in the audit log):
# ADMIN_TOKENS="alice:tok_alice,bob:tok_bob"
ADMIN_TOKENS=""
